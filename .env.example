# For Vercel runtime. Local npm run dev uses a persistent PGlite database if omitted.
DATABASE_URL=
# Optional dedicated connection for schema migrations.
DIRECT_DATABASE_URL=
# An authorized work email and a randomly generated setup code of at least 24 characters.
WALSHKEN_ADMIN_EMAIL=
WALSHKEN_SETUP_CODE=
# 32 random bytes in base64. Required before saving integration credentials.
WALSHKEN_INTEGRATION_KEY=
